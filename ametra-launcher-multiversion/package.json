{
  "name": "ametra-launcher",
  "version": "1.3.0",
  "description": "Launcher animado de Minecraft",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.ametra.launcher",
    "productName": "RzClient",
    "files": [
      "**/*",
      "!ametra-mod/**",
      "!ametra-guard/**",
      "!dist/**",
      "!build/**",
      "!installer/**",
      "!.build-tools/**",
      "!tools/**",
      "!server/**",
      "!*.bat",
      "!node_modules/.cache/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "RzClient",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "language": "1034",
      "createDesktopShortcut": true,
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "raxzdv",
        "repo": "RzClient-multiversion"
      }
    ]
  },
  "author": "Ametra"
}
